<Window
    x:Class="QuickExplain.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:QuickExplain"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="設定"
    Width="650"
    Height="500"
    MinWidth="650"
    MinHeight="450"
    Style="{StaticResource MaterialDesignWindow}"
    mc:Ignorable="d">

    <Window.DataContext>
        <local:SettingWindowViewModel />
    </Window.DataContext>

    <materialDesign:DialogHost
        x:Name="SettingsDialogHost"
        CloseOnClickAway="False"
        DialogClosing="SettingsDialogHost_DialogClosing">
        <materialDesign:DialogHost.DialogContent>
            <Border
                MinWidth="360"
                Padding="24">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="プロンプト設定をリセット" />
                    <TextBlock
                        Margin="0,0,0,24"
                        Text="プロンプト設定を初期状態に戻します。よろしいですか？"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="Cancel"
                            Content="キャンセル"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="OK"
                            Content="OK"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="30,0,30,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <TextBlock
                    Margin="-30,0,0,20"
                    FontSize="20"
                    Text="設定" />

                <!--  APIキー入力  -->
                <TextBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="Google API Key"
                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                    FontSize="15"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding GoogleApiKey}" />

                <TextBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="OpenAI API Key"
                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                    FontSize="15"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding OpenAiApiKey}" />

                <TextBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="Ollama Base URL"
                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                    FontSize="15"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding OllamaBaseUrl}" />

                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="12"
                    Text="Ollama モデル保持時間"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <ComboBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding OllamaKeepAliveItems}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding SelectedOllamaKeepAlive, Mode=TwoWay}" />

                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="12"
                    Text="ショートカット起動時のウィンドウタイプ"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <ComboBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding WindowTypeItems}"
                    SelectedItem="{Binding SelectedResultWindowType, Mode=TwoWay}" />

                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="12"
                    Text="テーマ"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <ComboBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding ThemeModeItems}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Mode"
                    SelectedValue="{Binding SelectedThemeMode, Mode=TwoWay}" />

                <TextBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="グローバルショートカットキー"
                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                    FontSize="15"
                    IsReadOnly="True"
                    PreviewKeyDown="GlobalHotKeyTextBox_PreviewKeyDown"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding GlobalHotKeyDisplay}" />

                <TextBox
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="スクリーンショートカットキー"
                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                    FontSize="15"
                    IsReadOnly="True"
                    PreviewKeyDown="ScreenshotHotKeyTextBox_PreviewKeyDown"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding ScreenshotHotKeyDisplay}" />

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"
                    Content="システム起動時に自動起動"
                    IsChecked="{Binding StartupWithWindows}"
                    Style="{StaticResource MaterialDesignCheckBox}" />

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"
                    Content="最小化して起動"
                    IsChecked="{Binding MinimizeToTray}"
                    Style="{StaticResource MaterialDesignCheckBox}" />

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"
                    Content="ダブルコピーでトリガーする"
                    IsChecked="{Binding EnableDoubleCopyAction}"
                    Style="{StaticResource MaterialDesignCheckBox}" />

                <Button
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"
                    Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}"
                    CommandTarget="{Binding ElementName=SettingsDialogHost}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <TextBlock Text="プロンプト設定をリセット" />
                </Button>

                <Border
                    Margin="0,12,0,0"
                    Padding="0,16,0,0"
                    BorderBrush="Gray"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            FontSize="13"
                            Text="{Binding UpdateStatusText}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="16,0,0,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="更新を確認">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Kind="Refresh" />
                        </Button>

                        <TextBlock
                            Grid.Column="2"
                            Margin="16,0,0,0"
                            FontSize="13"
                            Foreground="Gray"
                            Text="{Binding AppVersionText}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
    </materialDesign:DialogHost>


</Window>
