<Window
    x:Class="QuickExplain.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:QuickExplain"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="QuickExplain"
    Width="800"
    Height="450"
    MinWidth="700"
    MinHeight="300"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    Style="{StaticResource MaterialDesignWindow}"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <FontFamily x:Key="OutputFontFamily">Yu Gothic UI</FontFamily>
        <FontFamily x:Key="CodeFontFamily">Cascadia Mono, Consolas, Yu Gothic UI</FontFamily>
        <sys:Double x:Key="MarkdownFontSize">15</sys:Double>
        <sys:Double x:Key="MarkdownHeading1FontSize">27</sys:Double>
        <sys:Double x:Key="MarkdownHeading2FontSize">23</sys:Double>
        <sys:Double x:Key="MarkdownHeading3FontSize">20</sys:Double>
        <sys:Double x:Key="MarkdownHeading4FontSize">18</sys:Double>
        <sys:Double x:Key="MarkdownHeading5FontSize">16.5</sys:Double>
        <sys:Double x:Key="MarkdownHeading6FontSize">15</sys:Double>
        <Style x:Key="MarkdownParagraphStyle" TargetType="{x:Type Paragraph}">
            <Setter Property="FontFamily" Value="{StaticResource OutputFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource MarkdownFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource ChatAiBubbleForeground}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="MarkdownCodeStyle" TargetType="{x:Type Run}">
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
            <Setter Property="Background" Value="{DynamicResource MarkdownCodeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeForeground}" />
        </Style>
        <Style
            x:Key="MarkdownHeadingStyle"
            BasedOn="{StaticResource MarkdownParagraphStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style
            x:Key="MarkdownHeading1Style"
            BasedOn="{StaticResource MarkdownHeadingStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="{DynamicResource MarkdownHeading1FontSize}" />
        </Style>
        <Style
            x:Key="MarkdownHeading2Style"
            BasedOn="{StaticResource MarkdownHeadingStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="{DynamicResource MarkdownHeading2FontSize}" />
        </Style>
        <Style
            x:Key="MarkdownHeading3Style"
            BasedOn="{StaticResource MarkdownHeadingStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="{DynamicResource MarkdownHeading3FontSize}" />
        </Style>
        <Style
            x:Key="MarkdownHeading4Style"
            BasedOn="{StaticResource MarkdownHeadingStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="{DynamicResource MarkdownHeading4FontSize}" />
        </Style>
        <Style
            x:Key="MarkdownHeading5Style"
            BasedOn="{StaticResource MarkdownHeadingStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="{DynamicResource MarkdownHeading5FontSize}" />
        </Style>
        <Style
            x:Key="MarkdownHeading6Style"
            BasedOn="{StaticResource MarkdownHeadingStyle}"
            TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="{DynamicResource MarkdownHeading6FontSize}" />
        </Style>
        <Style
            x:Key="MarkdownListStyle"
            BasedOn="{StaticResource MarkdownParagraphStyle}"
            TargetType="{x:Type List}">
            <Setter Property="MarkerStyle" Value="Disc" />
        </Style>
        <Style x:Key="MarkdownTableRowGroupStyle" TargetType="{x:Type TableRowGroup}">
            <Setter Property="FontFamily" Value="{StaticResource OutputFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource MarkdownFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource ChatAiBubbleForeground}" />
        </Style>
        <mdxam:Markdown
            x:Key="MarkdownEngine"
            Heading1Style="{StaticResource MarkdownHeading1Style}"
            Heading2Style="{StaticResource MarkdownHeading2Style}"
            Heading3Style="{StaticResource MarkdownHeading3Style}"
            Heading4Style="{StaticResource MarkdownHeading4Style}"
            Heading5Style="{StaticResource MarkdownHeading5Style}"
            Heading6Style="{StaticResource MarkdownHeading6Style}"
            NormalParagraphStyle="{StaticResource MarkdownParagraphStyle}"
            CodeStyle="{StaticResource MarkdownCodeStyle}"
            TableBodyStyle="{StaticResource MarkdownTableRowGroupStyle}"
            TableHeaderStyle="{StaticResource MarkdownTableRowGroupStyle}" />
        <local:SafeMarkdownToFlowDocumentConverter
            x:Key="SafeMarkdownToFlowDocumentConverter"
            Markdown="{StaticResource MarkdownEngine}"
            ForegroundResourceKey="ChatAiBubbleForeground" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="5,0,0,0"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <Button
                Width="30"
                Height="30"
                HorizontalContentAlignment="Center"
                Command="{Binding OpenSettingWindowCommand}"
                Style="{StaticResource MaterialDesignIconForegroundButton}">
                <materialDesign:PackIcon
                    Width="17"
                    Height="17"
                    Kind="Cog" />
            </Button>
            <ComboBox
                Width="250"
                Height="36"
                Margin="12,0,4,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                materialDesign:HintAssist.Hint="モデル"
                FontSize="14"
                Padding="10,6,10,4"
                ItemsSource="{Binding AiModels}"
                SelectedItem="{Binding SelectedAiModel, Mode=TwoWay}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                Text="{Binding ProviderName}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Width="30"
                Height="30"
                Margin="0,0,8,0"
                Command="{Binding OpenModelAddWindowCommand}"
                Style="{StaticResource MaterialDesignIconForegroundButton}"
                ToolTip="モデルを編集">
                <materialDesign:PackIcon
                    Width="17"
                    Height="17"
                    Kind="Pencil" />
            </Button>
            <ComboBox
                Width="160"
                Height="36"
                Margin="0,0,8,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                materialDesign:HintAssist.Hint="プロンプト"
                FontSize="14"
                Padding="10,6,10,4"
                DisplayMemberPath="Name"
                ItemsSource="{Binding PromptProfiles}"
                SelectedItem="{Binding SelectedPromptProfile, Mode=TwoWay}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            <Button
                Width="30"
                Height="30"
                Command="{Binding OpenPromptEditorWindowCommand}"
                Style="{StaticResource MaterialDesignIconForegroundButton}">
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Kind="Pencil" />
            </Button>
        </StackPanel>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Height="32"
                MinWidth="104"
                Margin="0,0,8,0"
                Padding="12,0"
                Command="{Binding UpdateApplicationCommand}"
                FontSize="13"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding UpdateButtonText}" />
            </Button>
            <Button
                Width="32"
                Height="32"
                Command="{Binding StartNewChatCommand}"
                Style="{StaticResource MaterialDesignIconForegroundButton}">
                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Kind="ChatPlus" />
            </Button>
        </StackPanel>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="5,0,5,0"
            BorderBrush="Gray"
            BorderThickness="1,2,2,2"
            CornerRadius="4">
            <Grid>
                <ListBox
                    x:Name="ChatMessagesListBox"
                    Padding="10"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="{DynamicResource MarkdownFontSize}"
                    local:FontZoomBehavior.IsZoomEnabled="True"
                    ScrollViewer.CanContentScroll="False"
                    local:AutoScrollBehavior.IsEnabled="True"
                    ItemsSource="{Binding ChatMessages}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="materialDesign:RippleAssist.IsDisabled" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="MessageBubble"
                                    Grid.Row="0"
                                    Padding="10"
                                    Background="{DynamicResource ChatAiBubbleBackground}"
                                    BorderBrush="{DynamicResource ChatAiBubbleBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBox
                                                x:Name="UserMessageBody"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource ChatAiBubbleForeground}"
                                                materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                IsReadOnly="True"
                                                Style="{x:Null}"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                            <FlowDocumentScrollViewer
                                                x:Name="AssistantMessageBody"
                                                local:MouseWheelPassthroughBehavior.IsEnabled="True"
                                                FontFamily="{StaticResource OutputFontFamily}"
                                                Foreground="{DynamicResource ChatAiBubbleForeground}"
                                                Document="{Binding Text, Converter={StaticResource SafeMarkdownToFlowDocumentConverter}}"
                                                HorizontalScrollBarVisibility="Disabled"
                                                IsToolBarVisible="False"
                                                VerticalScrollBarVisibility="Disabled"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <Image
                                            x:Name="MessageImage"
                                            MaxWidth="360"
                                            MaxHeight="240"
                                            Margin="0,8,0,0"
                                            Source="{Binding ImageSource}"
                                            Stretch="Uniform"
                                            Visibility="Visible" />
                                        <StackPanel
                                            x:Name="AssistantMessageActions"
                                            Margin="5,8,0,0"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal"
                                            Visibility="{Binding CanShowAssistantActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                ToolTip="コピー"
                                                Visibility="{Binding CanCopyText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="ContentCopy" />
                                            </Button>
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Command="{Binding DataContext.ReloadMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                ToolTip="再生成"
                                                Visibility="{Binding CanReload, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="Reload" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel
                                    x:Name="UserMessageActions"
                                    Grid.Row="1"
                                    Margin="0,6,8,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Visibility="{Binding CanShowUserActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        ToolTip="コピー">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentCopy" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                    <Setter TargetName="MessageImage" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="user">
                                    <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource ChatAiBubbleBackground}" />
                                    <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{DynamicResource ChatAiBubbleBorder}" />
                                    <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="UserMessageBody" Property="Foreground" Value="{DynamicResource ChatUserBubbleForeground}" />
                                    <Setter TargetName="AssistantMessageBody" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                    <Setter TargetName="MessageBubble" Property="Background" Value="Transparent" />
                                    <Setter TargetName="MessageBubble" Property="BorderBrush" Value="Transparent" />
                                    <Setter TargetName="MessageBubble" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Left" />
                                    <Setter TargetName="UserMessageBody" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="AssistantMessageBody" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="AssistantMessageBody" Property="Foreground" Value="{DynamicResource ChatAiBubbleForeground}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    FontSize="16"
                    Foreground="#BFBFBF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Panel.ZIndex="1"
                    Text="なにか質問してみましょう"
                    Visibility="{Binding ChatMessages.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Visible, TargetNullValue=Visible}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="5,5,5,5"
            MaxHeight="220"
            BorderBrush="Gray"
            BorderThickness="2"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <ItemsControl
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="8,8,8,0"
                    ItemsSource="{Binding SelectedPromptProfile.QuickQuestions}">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowQuickQuestions}" Value="True" />
                                        <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,6,6"
                                Padding="10,3"
                                Command="{Binding DataContext.SendQuickQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                FontSize="13"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                                <TextBlock
                                    MaxWidth="180"
                                    Text="{Binding DisplayText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox
                    x:Name="QuestionTextBox"
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    materialDesign:HintAssist.Hint="質問を入力"
                    AcceptsReturn="True"
                    FontSize="16"
                    MinHeight="48"
                    MaxHeight="200"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Loaded="QuestionTextBox_Loaded"
                    TextChanged="QuestionTextBox_TextChanged">

                    <TextBox.InputBindings>
                        <KeyBinding Command="{Binding SendQuestionCommand}" Gesture="Enter" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Command="{Binding SendQuestionCommand}"
                    Style="{StaticResource MaterialDesignIconForegroundButton}">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="SendVariant" />
                </Button>

            </Grid>

        </Border>


    </Grid>

</Window>
